<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.airlift</groupId>
        <artifactId>airbase</artifactId>
        <version>421</version>
    </parent>

    <artifactId>vthreadtime</artifactId>
    <version>1.2-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Virtual Thread Time</name>
    <description>Measure virtual thread mounted time and scheduling activity on the JVM</description>
    <url>https://github.com/airlift/vthreadtime</url>

    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/airlift/vthreadtime.git</connection>
        <developerConnection>scm:git:git@github.com:airlift/vthreadtime.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/airlift/vthreadtime</url>
    </scm>

    <properties>
        <air.compiler.fail-warnings>true</air.compiler.fail-warnings>
        <air.check.skip-pmd>true</air.check.skip-pmd>
        <air.javadoc.lint>all,-missing</air.javadoc.lint>
        <air.test.jvm.additional-arguments>--enable-native-access=io.airlift.vthreadtime --illegal-native-access=deny</air.test.jvm.additional-arguments>
        <project.build.targetJdk>25</project.build.targetJdk>
        <vthreadtime.native.resources>${project.build.directory}/generated-native-resources</vthreadtime.native.resources>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${vthreadtime.native.resources}</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration>
                    <executable>${project.basedir}/src/main/c/build-native.sh</executable>
                    <arguments>
                        <argument>${vthreadtime.native.resources}</argument>
                    </arguments>
                </configuration>
                <executions>
                    <execution>
                        <id>build-native-library</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>generate-resources</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-classfile,-processing,-restricted,-serial</arg>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-Xplugin:ErrorProne \
                            @${air.main.basedir}/.mvn/errorprone.config \
                            -XepExcludedPaths:.*/target/generated-test-sources/test-annotations/.*</arg>
                    </compilerArgs>
                    <proc>full</proc>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${dep.errorprone.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
